# Скопируйте в .env.local (файл в .gitignore) и заполните значениями своего проекта Supabase.
# Для фронтенда (web/.env.local) нужны только VITE_SUPABASE_URL и VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
# Секретные — только для скриптов на своей машине, никогда во фронтенд и в git:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
